---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="page-hero">
  <div class="shell">
    <p class="eyebrow">{eyebrow}</p>
    <div class="page-hero__row">
      <h1>{title}</h1>
      <p>{description}</p>
    </div>
  </div>
</header>
