---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { navigation, profile, secondaryNavigation } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = profile.title,
  description = profile.description,
} = Astro.props;
const pageTitle = title === profile.title ? `${profile.name} · ${title}` : `${title} · ${profile.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: Astro.site,
  jobTitle: 'Machine Learning Researcher',
  affiliation: {
    '@type': 'Organization',
    name: 'The University of Queensland',
  },
  sameAs: [profile.github, profile.linkedin, profile.uq],
  knowsAbout: [
    'Machine Learning',
    'Computer Vision',
    'Fourier Analysis',
    'Deep Learning',
    'Natural Language Processing',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2216%22 fill=%22%2318181b%22/><text x=%2250%22 y=%2267%22 font-family=%22sans-serif%22 font-size=%2248%22 font-weight=%22600%22 text-anchor=%22middle%22 fill=%22%23ffffff%22>JW</text></svg>" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>
      (() => {
        let theme = 'light';
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') theme = stored;
        } catch (error) {
          /* storage unavailable, so fall back to the light default */
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <header class="header" data-header>
      <nav class="nav shell" aria-label="Main navigation">
        <a class="brand" href="/" aria-label="Jevi Waugh home">
          <span class="brand__mark">J</span>
          <span>Jevi Waugh</span>
        </a>
        <div class="nav__actions">
          <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false" data-theme-toggle>
            <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4.2" />
              <path d="M12 2.4v2.4M12 19.2v2.4M2.4 12h2.4M19.2 12h2.4M5.2 5.2l1.7 1.7M17.1 17.1l1.7 1.7M18.8 5.2l-1.7 1.7M6.9 17.1l-1.7 1.7" />
            </svg>
            <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.3 14.2A8.4 8.4 0 1 1 9.8 3.7a6.9 6.9 0 0 0 10.5 10.5Z" />
            </svg>
          </button>
          <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links" data-menu-toggle>
            <span aria-hidden="true">☰</span>
            <span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Menu</span>
          </button>
        </div>
        <div class="nav__links" id="nav-links" data-nav-links>
          {navigation.map((item) => (
            <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>
          ))}
          <a class="nav__contact" href="/contact/" aria-current={currentPath === '/contact/' ? 'page' : undefined}>Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer__inner shell">
        <nav class="footer__nav" aria-label="Secondary navigation">
          {secondaryNavigation.map((item) => (
            <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="footer__links">
          <a href={profile.github} rel="me">GitHub</a>
          <a href={profile.linkedin} rel="me">LinkedIn</a>
          <a href="/uploads/resume.pdf">CV</a>
        </div>
      </div>
      <div class="footer__legal shell">© {new Date().getFullYear()} Jevi Waugh</div>
    </footer>

    <script>
      const readTheme = () => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') return stored;
        } catch (error) {
          /* storage unavailable, so fall back to the light default */
        }
        return 'light';
      };

      const applyTheme = (theme: string) => {
        document.documentElement.dataset.theme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', theme === 'dark' ? '#0f0f11' : '#ffffff');
        const themeButton = document.querySelector('[data-theme-toggle]');
        themeButton?.setAttribute('aria-pressed', String(theme === 'dark'));
        themeButton?.setAttribute(
          'aria-label',
          theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode',
        );
      };

      /* Registered once and re-queried per scroll, rather than closing over a
         header that the router replaces on every navigation. */
      const updateHeader = () =>
        document.querySelector('[data-header]')?.classList.toggle('is-scrolled', window.scrollY > 12);
      window.addEventListener('scroll', updateHeader, { passive: true });

      /* The router swaps the body, so listeners are bound fresh each time.
         astro:page-load also fires on the initial load. */
      const bind = () => {
        const menuButton = document.querySelector('[data-menu-toggle]');
        const menu = document.querySelector('[data-nav-links]');

        updateHeader();

        menuButton?.addEventListener('click', () => {
          const open = menu?.classList.toggle('is-open') ?? false;
          menuButton.setAttribute('aria-expanded', String(open));
        });

        menu?.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            menu.classList.remove('is-open');
            menuButton?.setAttribute('aria-expanded', 'false');
          });
        });

        document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          applyTheme(next);
          try {
            localStorage.setItem('theme', next);
          } catch (error) {
            /* preference simply will not persist */
          }
        });

        applyTheme(readTheme());
      };

      document.addEventListener('astro:page-load', bind);

      /* Re-asserted before the new page paints: the incoming document carries
         no data-theme, so without this a transition flashes back to light. */
      document.addEventListener('astro:after-swap', () => applyTheme(readTheme()));
    </script>
  </body>
</html>
