---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The requested page could not be found.">
  <section class="hero shell" style="min-height:82svh">
    <p class="eyebrow">Error 404</p>
    <h1>Signal lost in the spectrum.</h1>
    <p class="lede">The page you followed does not exist, or it moved during the redesign.</p>
    <div class="page-actions">
      <a class="button button--primary" href="/">Return home</a>
      <a class="button" href="/projects/">Explore projects</a>
    </div>
  </section>
</BaseLayout>
