---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { education, experience, focusAreas, skillGroups } from '../data/profile';
---

<BaseLayout
  title="Experience"
  description="Research, teaching, engineering, and leadership experience from Jevi Waugh."
>
  <PageHero
    eyebrow="Background"
    title="Experience"
    description="Research, engineering, teaching, and leadership roles at The University of Queensland and in industry, with education and technical skills."
  />
  <div class="shell">
    <div class="page-actions page-actions--under-hero">
      <a class="button button--primary" href="/uploads/resume.pdf">Download full CV ↗</a>
    </div>
  </div>
  <section class="section shell">
    <div class="timeline timeline--railed">
      {experience.map((item) => (
        <article
          class:list={[
            'timeline__item',
            'reveal',
            { 'timeline__item--current': item.period.includes('Present') },
          ]}
        >
          <div>
            <div class="timeline__period">{item.period}</div>
            <div class="timeline__type">{item.type}</div>
          </div>
          <div>
            <div class="timeline__role">
              {item.href ? <a class="hero__link" href={item.href}>{item.role}</a> : item.role}
            </div>
            <div class="timeline__org">{item.organisation}</div>
          </div>
          <div>
            <p class="timeline__description">{item.description}</p>
            {item.highlights.length > 0 && (
              <ul class="timeline__highlights">
                {item.highlights.map((highlight) => <li set:html={highlight} />)}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="section shell">
    <div class="split">
      <div class="reveal">
        <p class="eyebrow">Education</p>
        <h2>Education</h2>
        {education.map((item) => (
          <article class:list={['education-card', { 'education-card--pending': item.status }]}>
            <span class="education-card__period">
              {item.period}
              {item.status && <span class="education-card__status">{item.status}</span>}
            </span>
            <h3>{item.degree}</h3>
            <p class="accent">{item.institution}</p>
            <p class="muted">{item.detail}</p>
          </article>
        ))}
      </div>
      <div class="reveal">
        <p class="eyebrow">Research focus</p>
        <h2>What I work on</h2>
        <p class="lede">
          The areas my research, projects, and reading keep returning to: mostly
          how visual models represent structure, and what mathematics explains
          their behaviour.
        </p>
        <div class="capabilities">
          {focusAreas.map((area) => <span class="capability">{area}</span>)}
        </div>
      </div>
    </div>
  </section>
  <section class="section--tight shell">
    <div class="section-heading reveal">
      <div>
        <p class="eyebrow">Technical toolkit</p>
        <h2>Languages and frameworks</h2>
      </div>
      <p>
        The full set used across research, data analysis, teaching, and software
        development.
      </p>
    </div>
    <div class="skill-groups">
      {skillGroups.map((group) => (
        <article class="skill-group reveal">
          <span class="detail__aside-label">{group.name}</span>
          <div class="capabilities">
            {group.items.map((item) => <span class="capability">{item}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
