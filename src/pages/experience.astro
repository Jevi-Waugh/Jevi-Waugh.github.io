---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { capabilities, education, experience, skillGroups } from '../data/profile';
---

<BaseLayout
  title="Experience"
  description="Research, teaching, engineering, and leadership experience from Jevi Waugh."
>
  <PageHero
    eyebrow="Experience"
    title="Working across ideas, people, and systems."
    description="Research gives me difficult questions. Engineering makes them concrete. Teaching and leadership make the work useful beyond myself."
  />
  <section class="section shell">
    <div class="timeline">
      {experience.map((item) => (
        <article class="timeline__item reveal">
          <div>
            <div class="timeline__period">{item.period}</div>
            <div class="timeline__type">{item.type}</div>
          </div>
          <div>
            <div class="timeline__role">{item.role}</div>
            <div class="timeline__org">{item.organisation}</div>
          </div>
          <div>
            <p class="timeline__description">{item.description}</p>
            {item.highlights.length > 0 && (
              <ul class="timeline__highlights">
                {item.highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="section shell">
    <div class="split">
      <div class="reveal">
        <p class="eyebrow">Education</p>
        <h2>Mathematical foundations, applied deeply.</h2>
        {education.map((item) => (
          <article class="education-card">
            <span class="education-card__period">{item.period}</span>
            <h3>{item.degree}</h3>
            <p class="accent">{item.institution}</p>
            <p class="muted">{item.detail}</p>
          </article>
        ))}
      </div>
      <div class="reveal">
        <p class="eyebrow">Working set</p>
        <h2>Tools follow the problem.</h2>
        <p class="lede">
          I work across mathematical modelling, experimental ML, data analysis, and software
          implementation.
        </p>
        <div class="capabilities">
          {capabilities.map((capability) => <span class="capability">{capability}</span>)}
        </div>
        <div style="margin-top:2rem">
          <a class="button button--primary" href="/uploads/resume.pdf">Download full CV ↗</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section--tight shell">
    <div class="section-heading reveal">
      <div>
        <p class="eyebrow">Technical toolkit</p>
        <h2>Languages and frameworks.</h2>
      </div>
      <p>
        A fuller view of the tools I use across research, data analysis, teaching, and
        software development.
      </p>
    </div>
    <div class="skill-groups">
      {skillGroups.map((group) => (
        <article class="skill-group reveal">
          <span class="detail__aside-label">{group.name}</span>
          <div class="capabilities">
            {group.items.map((item) => <span class="capability">{item}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
