---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gallery/*.{jpg,jpeg,JPG,JPEG,png,PNG,webp,WEBP,avif,AVIF}',
  { eager: true },
);

const images = Object.entries(imageModules)
  .map(([path, module]) => {
    const filename = path.split('/').pop()?.replace(/\.[^.]+$/, '') ?? 'Gallery image';
    const caption = filename
      .split(/[-_]/)
      .filter(Boolean)
      .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(' ');
    const year = Number(filename.match(/\b(?:19|20)\d{2}\b/)?.[0] ?? 0);

    return { src: module.default, caption, year };
  })
  .sort((a, b) => b.year - a.year || a.caption.localeCompare(b.caption));
---

<BaseLayout
  title="Gallery"
  description="A visual archive of Jevi Waugh’s research, community, teaching, and pursuits."
>
  <PageHero
    eyebrow="Gallery"
    title="Fragments from the work and everything around it."
    description="Research showcases, community events, teaching, travel, sport, and moments worth keeping."
  />
  <section class="section shell">
    {images.length > 0 ? (
      <div class="gallery-grid">
        {images.map((image, index) => (
          <figure
            class:list={[
              'gallery-item',
              'reveal',
              {
                'gallery-item--wide': index % 5 === 0 && image.src.width >= image.src.height,
                'gallery-item--portrait': image.src.height > image.src.width,
              },
            ]}
          >
            <Image src={image.src} alt={image.caption} widths={[480, 800, 1200]} sizes="(max-width: 700px) 100vw, 50vw" />
            <figcaption>{image.caption}</figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <div class="gallery-empty reveal">
        <p class="eyebrow">Archive being assembled</p>
        <h2>Photos are coming next.</h2>
        <p>
          Add images to <code>src/assets/gallery/</code> and they will appear here
          automatically. Descriptive filenames become the initial captions.
        </p>
      </div>
    )}
  </section>
</BaseLayout>
