---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { presenting } from '../data/media';
import { education, experience, metrics, profile } from '../data/profile';

const projects = (await getCollection('projects'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
const talk = (await getCollection('talks'))[0];
const currentRoles = experience.filter((item) => item.period.includes('Present'));
const study = education[0];
---

<BaseLayout>
  <section class="hero shell">
    <p class="eyebrow">{profile.location}</p>
    <h1>Jevi Waugh</h1>
    <p class="hero__description">
      Machine learning researcher working on frequency-domain methods for computer
      vision. I build the systems I study, and teach the mathematics behind them.
    </p>

    <ul class="hero__roles">
      {currentRoles.map((role) => (
        <li>
          <span class="hero__role">
            {role.href ? <a class="hero__link" href={role.href}>{role.role}</a> : role.role}
          </span>
          <span class="hero__org">{role.organisation}</span>
          <span class="hero__period">{role.period}</span>
        </li>
      ))}
      <li>
        <span class="hero__role">{study.degree}</span>
        <span class="hero__org">{study.institution}</span>
        <span class="hero__period">{study.period}</span>
      </li>
    </ul>

    <div class="hero__actions">
      <a class="button button--primary" href="/uploads/resume.pdf">Download CV ↗</a>
      <a class="button" href="/experience/">Full experience</a>
      <a class="button" href="/contact/">Contact</a>
    </div>

    <p class="hero__status">Open to research collaboration</p>
  </section>

  <section aria-label="Selected results">
    <div class="metrics shell">
      {metrics.map((metric) => (
        <div class="metric">
          <strong class="metric__value">{metric.value}</strong>
          <span class="metric__label">{metric.label}</span>
          <span class="metric__detail">{metric.detail}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section shell" id="research">
    <div class="section-heading reveal">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2>Projects</h2>
      </div>
      <p>
        Research prototypes and developer tools across computer vision, explainable
        AI, and NLP. Each links to methods, results, and source.
      </p>
    </div>
    <div class="work-grid">
      {projects.map((entry) => <WorkCard entry={entry} />)}
    </div>
    <div style="margin-top:2rem">
      <a class="button" href="/projects/">View all projects →</a>
    </div>
  </section>

  {talk && (
    <section class="section shell" id="talks">
      <div class="section-heading reveal">
        <div>
          <p class="eyebrow">Latest talk</p>
          <h2>{talk.data.event}</h2>
        </div>
        <p>{talk.data.summary}</p>
      </div>
      <p class="mono muted">{talk.data.date.toLocaleDateString('en-AU', { dateStyle: 'long' })}</p>
      <div style="margin-top:1.5rem">
        <a class="button" href={`/talks/${talk.id}/`}>Watch the talk →</a>
      </div>
    </section>
  )}

  <section class="section shell">
    <div class="feature reveal">
      <div class="feature__image">
        <Image
          src={presenting}
          alt="Jevi Waugh presenting frequency-domain segmentation work at the 2026 UQ Summer Research Program showcase"
          width={880}
          height={660}
          loading="lazy"
        />
      </div>
      <div class="feature__copy">
        <p class="eyebrow">About</p>
        <h2>Research, engineering, and teaching.</h2>
        <p>
          I am a research assistant and Master of Data Science student at
          <strong>The University of Queensland</strong>, working on computer vision,
          deep learning, and the mathematical structure behind model behaviour.
        </p>
        <p>
          Alongside research I teach capstone software delivery, pattern recognition,
          and introductory software engineering; work part-time as an AI engineer at
          Apex Fincap; and lead industry partnerships for UQ Computing Society.
        </p>
        <div class="page-actions">
          <a class="button button--primary" href="/contact/">Contact me</a>
          <a class="button" href={profile.linkedin}>LinkedIn ↗</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
