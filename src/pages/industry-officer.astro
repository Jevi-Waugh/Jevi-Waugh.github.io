---
import fs from 'node:fs';
import path from 'node:path';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import uqcsLogo from '../assets/media/UQCS Logo.png';
import sponsors from '../assets/media/2026 sponsors.png';
import agm from '../assets/media/uqcs-2026-agm.jpg';
import thankYouCard from '../assets/media/jevi-ty-card-industry-officer-2026.jpg';
import { experience, profile } from '../data/profile';

const role = experience.find(
  (item) => item.role === 'Industry Officer' && item.organisation === 'UQ Computing Society',
)!;

// Drop the report into static/uploads/ under this name and the section below
// publishes itself. Until then the page simply doesn't mention it.
const reportFile = 'uqcs-industry-officer-report.pdf';
const reportHref = `/uploads/${reportFile}`;
const hasReport = fs.existsSync(path.join(process.cwd(), 'static', 'uploads', reportFile));

// Page images are rendered from the PDF into src/assets/report/ (see README in
// that folder). Re-render them whenever the report itself changes.
const pageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/report/page-*.png',
  { eager: true },
);
const reportPageImages = Object.entries(pageModules)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, module]) => module.default);

// Full-resolution versions behind the lightbox. Without JS these stay plain
// links that open the image on its own.
const [sponsorsFull, agmFull, cardFull] = await Promise.all(
  [sponsors, agm, thankYouCard].map((src) => getImage({ src, format: 'webp' })),
);
---

<BaseLayout
  title="Industry Officer, UQ Computing Society"
  description="Jevi Waugh led sponsorship outreach, pitching, negotiation, and partner relationships as Industry Officer for UQ Computing Society across the 2026 term."
>
  <header class="page-hero">
    <div class="shell">
      <div class="page-hero__brand">
        <a class="page-hero__logo" href={profile.uqcs} aria-label="UQ Computing Society">
          <Image src={uqcsLogo} alt="UQ Computing Society" width={200} />
        </a>
        <div>
          <p class="eyebrow">Leadership · {role.period}</p>
          <h1>Industry Officer</h1>
        </div>
      </div>
      <p class="lede">{role.description}</p>
      <div class="page-actions">
        {hasReport && (
          <a class="button button--primary" href={reportHref} download>
            Download the officer report ↓
          </a>
        )}
        <a
          class="button"
          href="https://drive.google.com/file/d/1xJ_bIke-vXt_xp9oWRvofHUxUZKqDA4h/view?usp=drive_link"
        >
          2027 UQCS Prospectus ↗
        </a>
        <a class="button" href="https://github.com/UQComputingSociety/minutes">
          Committee minutes ↗
        </a>
        <a class="button" href={profile.uqcs}>UQ Computing Society ↗</a>
      </div>

      {!hasReport && (
        <p class="mono muted" style="margin:1.25rem 0 0">
          Officer report in progress. It will be published on this page.
        </p>
      )}
    </div>
  </header>

  <section class="section shell">
    <div class="detail">
      <div class="detail__content">
        <h2>The role</h2>
        <p>
          UQ Computing Society is one of the largest technology societies at The University
          of Queensland. As Industry Officer I owned the relationship between the society and
          the companies that fund and support it: identifying prospective partners, pitching
          the society, negotiating terms, and looking after those partnerships once signed.
          The term closed at the 2026 annual general meeting, and I continue with the society
          as Industry Subcommittee Advisor.
        </p>

        {hasReport && (
          <div class="report" data-report>
          <div class="report__stage">
            {reportPageImages.map((page, index) => (
              <Image
                class:list={['report__page', index === 0 && 'is-active']}
                src={page}
                alt={`Page ${index + 1} of the 2026 UQ Computing Society Industry Officer's Report`}
                width={760}
                loading={index === 0 ? 'eager' : 'lazy'}
                data-page={index + 1}
              />
            ))}
          </div>

          <div class="report__meta mono">
            <span data-report-label>
              Page 1 of {reportPageImages.length} · hover a page to preview
            </span>
            <a class="report__cta" href={reportHref}>Open the PDF ↗</a>
          </div>

          <ol class="report__thumbs">
            {reportPageImages.map((page, index) => (
              <li>
                <a
                  class:list={['report__thumb', index === 0 && 'is-active']}
                  href={`${reportHref}#page=${index + 1}`}
                  data-thumb={index + 1}
                  aria-label={`Preview page ${index + 1}`}
                >
                  <Image src={page} alt="" width={120} loading="lazy" />
                  <span class="report__thumb-number">{index + 1}</span>
                </a>
              </li>
            ))}
          </ol>
          </div>
        )}

        {!hasReport && (
          <p>
            The officer report documents the term in full: sponsorship pipeline, partner
            outcomes, and handover notes. It is not yet complete, and will be published
            on this page as a PDF once it is.
          </p>
        )}
      </div>

      <aside class="detail__aside">
        <div class="detail__aside-block">
          <span class="detail__aside-label">Organisation</span>
          <span>{role.organisation}</span>
        </div>
        <div class="detail__aside-block">
          <span class="detail__aside-label">Term</span>
          <ol class="tenure">
            <li class="tenure__item">
              <span class="tenure__years mono">2025 - 2026</span>
              <span class="tenure__role">Industry Officer</span>
            </li>
            <li class="tenure__item">
              <span class="tenure__years mono">2026 - 2027</span>
              <span class="tenure__role">Industry Subcommittee Advisor</span>
              <span class="tenure__note mono">Current</span>
            </li>
          </ol>
        </div>
        <div class="detail__aside-block">
          <span class="detail__aside-label">Focus</span>
          <span>Sponsorship &amp; industry partnerships</span>
        </div>
        <div class="detail__aside-block">
          <span class="detail__aside-label">Links</span>
          <span><a href={profile.uqcs}>uqcs.org ↗</a></span>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--tight shell">
    <div class="closing">
      <div class="closing__column">
        <div class="section-heading">
          <h2>2026 sponsors</h2>
          <p>The partners who backed UQ Computing Society across my term.</p>
        </div>
        <a class="sponsors" href={sponsorsFull.src} data-zoom>
          <Image
            src={sponsors}
            alt="UQ Computing Society 2026 sponsors: hackathon, social, and industry partners"
            width={1405}
            loading="lazy"
          />
        </a>
      </div>

      <div class="closing__column">
        <div class="section-heading">
          <h2>Handover</h2>
          <p>The 2026 term closed at the annual general meeting in October.</p>
        </div>
        <div class="closing__photos">
          <figure class="closing__photo">
            <a href={agmFull.src} data-zoom>
              <Image
                src={agm}
                alt="The UQ Computing Society 2026 committee at the annual general meeting"
                width={1100}
                loading="lazy"
              />
            </a>
            <figcaption>The 2026 committee at the AGM.</figcaption>
          </figure>
          <figure class="closing__photo closing__photo--crop">
            <a href={cardFull.src} data-zoom>
              <Image
                src={thankYouCard}
                alt="A signed farewell card from the committee next to a 3D-printed pickaxe trophy engraved with my name"
                width={1100}
                loading="lazy"
              />
            </a>
            <figcaption>A signed card and a 3D-printed trophy from the committee.</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <dialog class="lightbox" data-lightbox aria-label="Full size image">
    <button class="lightbox__close" type="button" data-lightbox-close aria-label="Close">
      ×
    </button>
    <img data-lightbox-image src="" alt="" />
  </dialog>

</BaseLayout>

<script>
  // Hovering (or focusing) a thumbnail swaps the large preview. Without JS the
  // thumbnails stay plain links that open the PDF at that page.
  const bindReport = () => {
    const report = document.querySelector<HTMLElement>('[data-report]');
    if (!report) return;

    const pages = report.querySelectorAll<HTMLElement>('.report__page');
    const thumbs = report.querySelectorAll<HTMLAnchorElement>('[data-thumb]');
    const label = report.querySelector<HTMLElement>('[data-report-label]');
    const total = pages.length;

    const show = (number: number) => {
      pages.forEach((page) => {
        page.classList.toggle('is-active', page.dataset.page === String(number));
      });
      thumbs.forEach((thumb) => {
        thumb.classList.toggle('is-active', thumb.dataset.thumb === String(number));
      });
      if (label) {
        label.textContent = `Page ${number} of ${total} · hover a page to preview`;
      }
    };

    thumbs.forEach((thumb) => {
      const number = Number(thumb.dataset.thumb);
      thumb.addEventListener('mouseenter', () => show(number));
      thumb.addEventListener('focus', () => show(number));
      // On touch the first tap previews rather than jumping straight to the PDF.
      thumb.addEventListener('click', (event) => {
        if (window.matchMedia('(hover: none)').matches && !thumb.classList.contains('is-active')) {
          event.preventDefault();
          show(number);
        }
      });
    });
  };

  // Clicking a photo opens it full size. Without JS the links simply open the
  // image itself, so nothing is lost.
  const bindLightbox = () => {
    const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    const image = dialog?.querySelector<HTMLImageElement>('[data-lightbox-image]');
    if (!dialog || !image) return;

    const close = () => {
      if (dialog.open) dialog.close();
      image.removeAttribute('src');
    };

    document.querySelectorAll<HTMLAnchorElement>('[data-zoom]').forEach((trigger) => {
      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        const caption = trigger.querySelector('img')?.alt ?? '';
        image.src = trigger.href;
        image.alt = caption;
        dialog.showModal();
      });
    });

    dialog.addEventListener('close', () => image.removeAttribute('src'));
    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', close);
    // Clicking the backdrop (anywhere outside the image) dismisses it too.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });
  };

  /* The router swaps the body, so listeners are bound fresh each time. */
  document.addEventListener('astro:page-load', () => {
    bindReport();
    bindLightbox();
  });
</script>
