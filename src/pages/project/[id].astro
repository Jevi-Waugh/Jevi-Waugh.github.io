---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getMedia } from '../../data/media';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  const canonical = entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
  const legacyAliases: Record<string, string> = {
    phaml: 'ph-aml',
    'table-tennis': 'table-tennis-classification',
    gallstones: 'analysis-of-gallstones',
  };
  const legacy = entries
    .filter((entry) => legacyAliases[entry.id])
    .map((entry) => ({
      params: { id: legacyAliases[entry.id] },
      props: { entry },
    }));
  return [...canonical, ...legacy];
}

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, date, kind, tags, links, imageKey } = entry.data;
const image = getMedia(imageKey);
---

<BaseLayout title={title} description={summary}>
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">{kind} · {date.getFullYear()}</p>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>
      {links.length > 0 && (
        <div class="page-actions">
          {links.map((link, index) => (
            <a class:list={['button', { 'button--primary': index === 0 }]} href={link.href}>
              {link.label} ↗
            </a>
          ))}
        </div>
      )}
    </div>
  </header>
  <article class="section shell">
    {image && <Image class="detail__hero-image" src={image} alt="" width={1400} height={780} />}
    <div class="detail">
      <div class="detail__content">
        <Content />
      </div>
      <aside class="detail__aside" aria-label="Project details">
        <div class="detail__aside-block">
          <span class="detail__aside-label">Year</span>
          <span>{date.getFullYear()}</span>
        </div>
        <div class="detail__aside-block">
          <span class="detail__aside-label">Type</span>
          <span>{kind}</span>
        </div>
        <div class="detail__aside-block">
          <span class="detail__aside-label">Topics</span>
          <ul class="tag-list">
            {tags.map((tag) => <li class="tag">{tag}</li>)}
          </ul>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
