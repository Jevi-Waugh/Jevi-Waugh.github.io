---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { pursuits } from '../data/profile';
---

<BaseLayout
  title="Pursuits"
  description="The interests, sports, games, and outdoor activities Jevi Waugh pursues beyond research and engineering."
>
  <PageHero
    eyebrow="Outside work"
    title="Pursuits"
    description="Interests and communities outside research and engineering: music, games, the outdoors, and team sport."
  />
  <section class="section--tight shell">
    <div class="pursuits-grid">
      {pursuits.map((pursuit) => (
        <article class="pursuit-card">
          <h2>{pursuit.title}</h2>
          <div class="pursuit-card__body">
            <span class="pursuit-card__label">{pursuit.label}</span>
            <p>{pursuit.description}</p>
          </div>
        </article>
      ))}
    </div>
    <div style="margin-top:2rem">
      <a class="button" href="/gallery/">See the gallery →</a>
    </div>
  </section>
</BaseLayout>
