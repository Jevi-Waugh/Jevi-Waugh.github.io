---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('talks');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'talks'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, date, event, location, recording, links } = entry.data;
---

<BaseLayout title={title} description={summary}>
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">{event} · {date.toLocaleDateString('en-AU', { dateStyle: 'long' })}</p>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>
      <div class="page-actions">
        {links.map((link, index) => (
          <a class:list={['button', { 'button--primary': index === 0 }]} href={link.href}>{link.label} ↗</a>
        ))}
      </div>
    </div>
  </header>
  <article class="section shell">
    {recording && (
      <div style="position:relative;width:100%;padding-top:56.25%;margin-bottom:4rem;border-radius:20px;overflow:hidden;border:1px solid var(--line)">
        <iframe
          src={recording}
          title={title}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          style="position:absolute;inset:0;width:100%;height:100%;border:0"
        ></iframe>
      </div>
    )}
    <div class="detail">
      <div class="detail__content"><Content /></div>
      <aside class="detail__aside">
        <div class="detail__aside-block">
          <span class="detail__aside-label">Event</span>
          <span>{event}</span>
        </div>
        {location && (
          <div class="detail__aside-block">
            <span class="detail__aside-label">Location</span>
            <span>{location}</span>
          </div>
        )}
      </aside>
    </div>
  </article>
</BaseLayout>
