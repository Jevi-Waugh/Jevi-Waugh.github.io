---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getMedia } from '../../data/media';

const talks = (await getCollection('talks')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Talks" description="Research talks and presentations by Jevi Waugh.">
  <PageHero
    eyebrow="Presentations"
    title="Talks"
    description="Presentations on frequency-domain vision, image segmentation, and the process behind research results."
  />
  <section class="section shell">
    <div class="timeline timeline--media">
      {talks.map((talk) => {
        const cover = getMedia(talk.data.imageKey);
        return (
        <a class="timeline__item reveal" href={`/talks/${talk.id}/`}>
          <div class="timeline__media">
            {cover && <Image src={cover} alt="" width={440} height={280} loading="lazy" />}
          </div>
          <div>
            <div class="timeline__period">{talk.data.date.toLocaleDateString('en-AU')}</div>
            <div class="timeline__type">Talk</div>
          </div>
          <div>
            <div class="timeline__role">{talk.data.title}</div>
            <div class="timeline__org">{talk.data.event}</div>
          </div>
          <p class="timeline__description">{talk.data.summary}</p>
        </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
