---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

const courses = (await getCollection('teaching')).sort((a, b) => a.data.order - b.data.order);
const isCurrent = (course: (typeof courses)[number]) => course.data.period?.includes('Present');

const groups = [
  { label: 'Currently teaching', courses: courses.filter(isCurrent) },
  { label: 'Previously taught', courses: courses.filter((course) => !isCurrent(course)) },
].filter((group) => group.courses.length > 0);
---

<BaseLayout
  title="Teaching"
  description="Jevi Waugh teaches capstone design, pattern recognition, and software engineering at UQ, and has taught machine learning, functional programming, and theory of computing."
>
  <PageHero
    eyebrow="Teaching at UQ"
    title="Teaching"
    description="Currently teaching capstone software delivery (DECO3801), pattern recognition and deep learning (COMP3710), and introductory software engineering (CSSE1001). Previously machine learning, programming paradigms, and theory of computing."
  />
  {groups.map((group) => (
    <section class="section--tight shell">
      <p class="eyebrow">{group.label}</p>
      <div class="teaching-grid">
        {group.courses.map((course) => (
          <a class="teaching-card reveal" href={`/teaching/${course.id}/`}>
            <div class="teaching-card__meta">
              <span class="teaching-card__code">{course.data.code}</span>
              {course.data.period && (
                <span class="teaching-card__period">{course.data.period}</span>
              )}
            </div>
            <div class="teaching-card__body">
              <h2>{course.data.title}</h2>
              <p>{course.data.summary}</p>
            </div>
            <span class="teaching-card__arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
